generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  memberships      Membership[]
  products         Product[]
  customers        Customer[]
  orders           Order[]
  integrations     Integration[]
  automations      Automation[]
  aiDecisions      AiDecision[]
  activityLogs     ActivityLog[]
  automationEvents AutomationEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("member")
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String?
  name           String
  description    String?
  priceCents     Int          @default(0)
  stock          Int          @default(0)
  active         Boolean      @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@unique([organizationId, sku])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  externalId     String?
  channel        String       @default("manual")
  status         String       @default("pending")
  totalCents     Int          @default(0)
  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@unique([organizationId, channel, externalId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  quantity  Int      @default(1)
  unitCents Int      @default(0)
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  status         String       @default("not_configured")
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
}

model Automation {
  id              String                     @id @default(cuid())
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean                    @default(false)
  trigger         Json
  conditions      Json?
  action          Json
  eventExecutions AutomationEventExecution[]
  deletedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([organizationId, enabled, deletedAt])
}

model AiDecision {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  taskType       String
  inputSummary   String?
  decision       Json?
  confidence     Float?
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Decimal?     @db.Decimal(12, 8)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorType      String
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model AutomationEvent {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggerType    String
  entityType     String?
  entityId       String?
  dedupeKey      String
  payload        Json
  status         String                     @default("pending")
  attempts       Int                        @default(0)
  lastError      String?
  createdAt      DateTime                   @default(now())
  processedAt    DateTime?
  executions     AutomationEventExecution[]

  @@unique([organizationId, triggerType, dedupeKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, triggerType, entityId])
}

model AutomationEventExecution {
  id           String          @id @default(cuid())
  eventId      String
  automationId String
  event        AutomationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  automation   Automation      @relation(fields: [automationId], references: [id], onDelete: Restrict)
  status       String          @default("pending")
  attempts     Int             @default(0)
  lastError    String?
  startedAt    DateTime?
  processedAt  DateTime?
  createdAt    DateTime        @default(now())

  @@unique([eventId, automationId])
  @@index([status, createdAt])
  @@index([automationId, status])
}
