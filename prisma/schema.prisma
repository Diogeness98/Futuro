generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  memberships      Membership[]
  products         Product[]
  customers        Customer[]
  orders           Order[]
  integrations     Integration[]
  automations      Automation[]
  aiDecisions      AiDecision[]
  activityLogs          ActivityLog[]
  automationEvents      AutomationEvent[]
  automationLockedAt    DateTime?
  automationLockToken   String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([automationLockedAt])
}

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("member")
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Product {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku               String?
  externalId        String?
  channel           String           @default("manual")
  name              String
  description       String?
  priceCents        Int              @default(0)
  currency          String?
  stock             Int              @default(0)
  active            Boolean          @default(true)
  externalStatus    String?
  externalUpdatedAt DateTime?
  sourceShopCipher  String?
  sourceShopName    String?
  lowStockEpisodeId String?
  lowStockEventAt   DateTime?
  variants          ProductVariant[]
  orderItems        OrderItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizationId])
  @@index([organizationId, channel])
  @@unique([organizationId, channel, sku])
  @@unique([organizationId, channel, externalId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalId     String
  sellerSku      String?
  priceCents     Int      @default(0)
  currency       String?
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@unique([productId, externalId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  externalId     String?
  channel        String       @default("manual")
  status         String       @default("pending")
  totalCents     Int          @default(0)
  sourceShopCipher String?
  sourceShopName   String?
  needUploadInvoice String?
  orderType         String?
  fulfillmentType  String?
  shippingType     String?
  detailsSyncedAt  DateTime?
  externalUpdatedAt DateTime?
  orderCreatedEventAt DateTime?
  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@unique([organizationId, channel, externalId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalId    String?
  externalSkuId String?
  sellerSku     String?
  name          String
  quantity      Int      @default(1)
  unitCents     Int      @default(0)
  currency      String?

  @@index([orderId])
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  status         String       @default("not_configured")
  config         Json?
  syncLockedAt   DateTime?
  syncLockToken  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([provider, status, syncLockedAt])
}

model Automation {
  id              String                     @id @default(cuid())
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean                    @default(false)
  trigger         Json
  conditions      Json?
  action          Json
  eventExecutions AutomationEventExecution[]
  deletedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([organizationId, enabled, deletedAt])
}

model AiDecision {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          String
  taskType          String
  inputSummary      String?
  decision          Json?
  confidence        Float?
  inputTokens       Int?
  outputTokens      Int?
  openAiAttempted   Boolean      @default(false)
  openAiInputTokens Int?
  openAiOutputTokens Int?
  costUsd           Decimal?     @db.Decimal(12, 8)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorType      String
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model AutomationEvent {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggerType    String
  entityType     String?
  entityId       String?
  dedupeKey      String
  payload        Json
  status         String                     @default("pending")
  attempts       Int                        @default(0)
  lastError      String?
  createdAt      DateTime                   @default(now())
  processedAt    DateTime?
  executions     AutomationEventExecution[]

  @@unique([organizationId, triggerType, dedupeKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, triggerType, entityId])
}

model AutomationEventExecution {
  id           String          @id @default(cuid())
  eventId      String
  automationId String
  event        AutomationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  automation   Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String          @default("pending")
  attempts     Int             @default(0)
  lastError    String?
  result       Json?
  startedAt    DateTime?
  processedAt  DateTime?
  createdAt    DateTime        @default(now())

  @@unique([eventId, automationId])
  @@index([status, createdAt])
  @@index([automationId, status])
}
