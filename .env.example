# Database
DATABASE_URL="postgresql://user:password@localhost:5432/futuro"

# OpenAI — server only. Never expose this key in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-5.6-luna"
OPENAI_ESCALATION_MODEL="gpt-5.6-sol"
OPENAI_MAX_INPUT_CHARS="12000"

# Jev / TypeSafe AI — server only.
# Keep JEV_MODE=mock until the account's exact API endpoint/payload is confirmed.
JEV_MODE="mock"
JEV_API_KEY=""
JEV_API_URL=""
JEV_AUTO_EXECUTE_THRESHOLD="0.92"
JEV_GPT_REVIEW_THRESHOLD="0.75"
